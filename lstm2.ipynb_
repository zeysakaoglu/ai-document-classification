tebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    <div id=\"df-d975e6e3-91cc-46dd-aae2-2c867de3e34c\">\n","      <button class=\"colab-df-quickchart\" onclick=\"quickchart('df-d975e6e3-91cc-46dd-aae2-2c867de3e34c')\"\n","                title=\"Suggest charts\"\n","                style=\"display:none;\">\n","\n","<svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","     width=\"24px\">\n","    <g>\n","        <path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z\"/>\n","    </g>\n","</svg>\n","      </button>\n","\n","<style>\n","  .colab-df-quickchart {\n","      --bg-color: #E8F0FE;\n","      --fill-color: #1967D2;\n","      --hover-bg-color: #E2EBFA;\n","      --hover-fill-color: #174EA6;\n","      --disabled-fill-color: #AAA;\n","      --disabled-bg-color: #DDD;\n","  }\n","\n","  [theme=dark] .colab-df-quickchart {\n","      --bg-color: #3B4455;\n","      --fill-color: #D2E3FC;\n","      --hover-bg-color: #434B5C;\n","      --hover-fill-color: #FFFFFF;\n","      --disabled-bg-color: #3B4455;\n","      --disabled-fill-color: #666;\n","  }\n","\n","  .colab-df-quickchart {\n","    background-color: var(--bg-color);\n","    border: none;\n","    border-radius: 50%;\n","    cursor: pointer;\n","    display: none;\n","    fill: var(--fill-color);\n","    height: 32px;\n","    padding: 0;\n","    width: 32px;\n","  }\n","\n","  .colab-df-quickchart:hover {\n","    background-color: var(--hover-bg-color);\n","    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.3), 0 1px 3px 1px rgba(60, 64, 67, 0.15);\n","    fill: var(--button-hover-fill-color);\n","  }\n","\n","  .colab-df-quickchart-complete:disabled,\n","  .colab-df-quickchart-complete:disabled:hover {\n","    background-color: var(--disabled-bg-color);\n","    fill: var(--disabled-fill-color);\n","    box-shadow: none;\n","  }\n","\n","  .colab-df-spinner {\n","    border: 2px solid var(--fill-color);\n","    border-color: transparent;\n","    border-bottom-color: var(--fill-color);\n","    animation:\n","      spin 1s steps(1) infinite;\n","  }\n","\n","  @keyframes spin {\n","    0% {\n","      border-color: transparent;\n","      border-bottom-color: var(--fill-color);\n","      border-left-color: var(--fill-color);\n","    }\n","    20% {\n","      border-color: transparent;\n","      border-left-color: var(--fill-color);\n","      border-top-color: var(--fill-color);\n","    }\n","    30% {\n","      border-color: transparent;\n","      border-left-color: var(--fill-color);\n","      border-top-color: var(--fill-color);\n","      border-right-color: var(--fill-color);\n","    }\n","    40% {\n","      border-color: transparent;\n","      border-right-color: var(--fill-color);\n","      border-top-color: var(--fill-color);\n","    }\n","    60% {\n","      border-color: transparent;\n","      border-right-color: var(--fill-color);\n","    }\n","    80% {\n","      border-color: transparent;\n","      border-right-color: var(--fill-color);\n","      border-bottom-color: var(--fill-color);\n","    }\n","    90% {\n","      border-color: transparent;\n","      border-bottom-color: var(--fill-color);\n","    }\n","  }\n","</style>\n","\n","      <script>\n","        async function quickchart(key) {\n","          const quickchartButtonEl =\n","            document.querySelector('#' + key + ' button');\n","          quickchartButtonEl.disabled = true;  // To prevent multiple clicks.\n","          quickchartButtonEl.classList.add('colab-df-spinner');\n","          try {\n","            const charts = await google.colab.kernel.invokeFunction(\n","                'suggestCharts', [key], {});\n","          } catch (error) {\n","            console.error('Error during call to suggestCharts:', error);\n","          }\n","          quickchartButtonEl.classList.remove('colab-df-spinner');\n","          quickchartButtonEl.classList.add('colab-df-quickchart-complete');\n","        }\n","        (() => {\n","          let quickchartButtonEl =\n","            document.querySelector('#df-d975e6e3-91cc-46dd-aae2-2c867de3e34c button');\n","          quickchartButtonEl.style.display =\n","            google.colab.kernel.accessAllowed ? 'block' : 'none';\n","        })();\n","      </script>\n","    </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"df","summary":"{\n  \"name\": \"df\",\n  \"rows\": 3609,\n  \"fields\": [\n    {\n      \"column\": \"text\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3608,\n        \"samples\": [\n          \"KONU: M\\u00fc\\u015fteri Memnuniyeti ve Operasyonel Performans\\nSay\\u0131n \\u0130cra Kurulu,\\nSon d\\u00f6nem m\\u00fc\\u015fteri geri bildirimlerinde sipari\\u015f iptallerinde\\ngecikmeler art\\u0131\\u015f g\\u00f6stermi\\u015ftir. Bu durum m\\u00fc\\u015fteri kayb\\u0131 riski\\na\\u00e7\\u0131s\\u0131ndan kritik risk ta\\u015f\\u0131maktad\\u0131r.\\nKalite birimi, \\u00e7a\\u011fr\\u0131 memnuniyeti analizini g\\u00fcncellemi\\u015ftir.\\nCRM ekibi, m\\u00fc\\u015fteri segmentasyonunun revize edilmesini \\u00f6nermi\\u015ftir.\\nOperasyon ekibi, temsilci performans\\u0131n\\u0131 art\\u0131rmak i\\u00e7in e\\u011fitim plan\\u0131 haz\\u0131rlam\\u0131\\u015ft\\u0131r.\\nTeknik ekip, uygulama hatalar\\u0131n\\u0131n giderilmesi i\\u00e7in g\\u00fcncelleme planlam\\u0131\\u015ft\\u0131r.\\nSayg\\u0131lar\\u0131mla,\\nCaner Yal\\u00e7\\u0131n\\n\\u00c7a\\u011fr\\u0131 Merkezi M\\u00fcd\\u00fcr\\u00fc\\nVeriNet M\\u00fc\\u015fteri Hizmetleri\",\n          \"KONU: Ar-Ge Ekibi 1 \\u00c7al\\u0131\\u015fmalar\\u0131, Finans Departman\\u0131 3al De\\u011ferlendirme, Hukuk Birimi 4i\\nUyum, \\u0130nsan Kaynaklar\\u0131 Birimi 4 Koordinasyonu ve M\\u00fc\\u015fteri Talepleri Say\\u0131n \\u0130lgili, Ar-Ge\\nEkibi 1 birimi taraf\\u0131ndan y\\u00fcr\\u00fct\\u00fclen teknik geli\\u015ftirme \\u00e7al\\u0131\\u015fmalar\\u0131, test raporlar\\u0131, yaz\\u0131l\\u0131m\\nmod\\u00fcl\\u00fc g\\u00fcncellemeleri, donan\\u0131m prototip s\\u00fcre\\u00e7leri, finansal de\\u011ferlendirmeler, hukuk\\nbirimi taraf\\u0131ndan yap\\u0131lan s\\u00f6zle\\u015fme kontrolleri ve m\\u00fc\\u015fteri hizmetleri geri bildirimleri\\nkapsam\\u0131nda haz\\u0131rlanan de\\u011ferlendirme a\\u015fa\\u011f\\u0131da sunulmaktad\\u0131r. 1) Teknik Geli\\u015ftirmeler:\\n- Yeni mod\\u00fcl tasar\\u0131mlar\\u0131na ili\\u015fkin prototip \\u00e7al\\u0131\\u015fmalar\\u0131 tamamlanm\\u0131\\u015f ve test s\\u00fcrecine\\nal\\u0131nm\\u0131\\u015ft\\u0131r. - Operasyon biriminden gelen m\\u00fc\\u015fteri talep raporlar\\u0131 do\\u011frultusunda baz\\u0131\\nteknik gereksinimlerde g\\u00fcncelleme yap\\u0131lm\\u0131\\u015ft\\u0131r. 2) Finans Departman\\u0131 3al S\\u00fcre\\u00e7ler: -\\nFinans Departman\\u0131 3 departman\\u0131 taraf\\u0131ndan haz\\u0131rlanan maliyet-planlama tablolar\\u0131nda,\\nAr-Ge Ekibi 1 geli\\u015ftirmelerine y\\u00f6nelik ek kaynak ihtiyac\\u0131 belirlenmi\\u015ftir. - Test ortam\\u0131 i\\u00e7in\\ntalep edilen donan\\u0131mlar\\u0131n b\\u00fct\\u00e7e etkileri de\\u011ferlendirilmi\\u015ftir. 3) Hukuk Birimi 4i\\nDe\\u011ferlendirmeler: - Yeni geli\\u015ftirilen mod\\u00fcllerin veri g\\u00fcvenli\\u011fi ve mevzuat uyumlulu\\u011fu\\nhukuk birimi taraf\\u0131ndan incelenmi\\u015ftir. - \\u00dcr\\u00fcn teslim s\\u00fcre\\u00e7lerine ili\\u015fkin s\\u00f6zle\\u015fme\\nmaddelerinde g\\u00fcncelleme \\u00f6nerileri payla\\u015f\\u0131lm\\u0131\\u015ft\\u0131r. 4) \\u0130nsan Kaynaklar\\u0131 Birimi 4 S\\u00fcre\\u00e7leri:\\n- Ar-Ge Ekibi 1 ekibinde g\\u00f6revli personelin vardiya da\\u011f\\u0131l\\u0131mlar\\u0131, yo\\u011fun proje periyotlar\\u0131na\\ng\\u00f6re yeniden planlanm\\u0131\\u015ft\\u0131r. - E\\u011fitim ihtiya\\u00e7 analizi \\u0130nsan Kaynaklar\\u0131 Birimi 4 birimi\\ntaraf\\u0131ndan g\\u00fcncellenmi\\u015ftir. 5) M\\u00fc\\u015fteri Hizmetleri Birimi 3 Geri Bildirimleri: - Son d\\u00f6nem\\nm\\u00fc\\u015fteri \\u015fikayet ve memnuniyet raporlar\\u0131 teknik geli\\u015ftirme planlar\\u0131na entegre edilmi\\u015ftir.\\n- M\\u00fc\\u015fteri hizmetleri birimiyle ortak aksiyon plan\\u0131 haz\\u0131rlanm\\u0131\\u015ft\\u0131r. Bilgilerinize arz ederim.\",\n          \"Veri Do\\u011frulama Hiyerar\\u015fisinin Analitik Katk\\u0131s\\u0131\\nRisk \\u00f6ncelik e\\u015flemesi kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda iteratif\\nolarak geli\\u015ftirildi. Bu \\u00e7er\\u00e7evede uyarlanabilir politika dengesi operasyonel ba\\u011flam alt\\u0131nda\\nba\\u011f\\u0131ms\\u0131z \\u00f6l\\u00e7\\u00fcmlerle do\\u011fruland\\u0131 ve izleme \\u00f6l\\u00e7\\u00fctleri yeniden tan\\u0131mland\\u0131. \\u0130lgili sonu\\u00e7lar dikkate\\nal\\u0131nd\\u0131\\u011f\\u0131nda olas\\u0131l\\u0131ksal kararl\\u0131l\\u0131k \\u00f6l\\u00e7\\u00fct\\u00fc ard\\u0131\\u015f\\u0131k karar noktalar\\u0131nda sistematik bi\\u00e7imde incelendi\\nve alternatif yakla\\u015f\\u0131mlar ayr\\u0131\\u015ft\\u0131r\\u0131ld\\u0131. Bu de\\u011ferlendirme sonucunda uyarlanabilir politika dengesi\\nger\\u00e7ek\\u00e7i varsay\\u0131mlar e\\u015fli\\u011finde ard\\u0131\\u015f\\u0131k a\\u015famalarda g\\u00f6zlemlendi ve izleme \\u00f6l\\u00e7\\u00fctleri yeniden\\ntan\\u0131mland\\u0131.\\n\\u00d6l\\u00e7\\u00fcm do\\u011frulama band\\u0131 kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar \\u00e7oklu senaryo ortam\\u0131nda ard\\u0131\\u015f\\u0131k\\na\\u015famalarda g\\u00f6zlemlendi. Bu \\u00e7er\\u00e7evede karar s\\u00fcreklilik e\\u015fi\\u011fi k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda farkl\\u0131\\nperspektiflerden yorumland\\u0131 ve karar s\\u0131n\\u0131rlar\\u0131 yeniden belirlendi. Buna paralel olarak zaman\\n\\u00e7\\u00f6z\\u00fcn\\u00fcrl\\u00fck penceresi zaman ufku boyunca kapsaml\\u0131 bi\\u00e7imde s\\u0131nand\\u0131 ve performans farklar\\u0131\\nnetle\\u015ftirildi. \\u0130lgili sonu\\u00e7lar dikkate al\\u0131nd\\u0131\\u011f\\u0131nda uygulama s\\u00fcreklilik seviyesi k\\u0131s\\u0131tl\\u0131 kaynak\\nko\\u015fullar\\u0131nda nicemsel g\\u00f6stergelerle de\\u011ferlendirildi ve uyum gereksinimleri yeniden\\nyap\\u0131land\\u0131r\\u0131ld\\u0131.\\nSapma davran\\u0131\\u015f \\u00f6r\\u00fcnt\\u00fcs\\u00fc kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda \\u00e7ok\\nboyutlu bi\\u00e7imde analiz edildi. Elde edilen bulgular do\\u011frultusunda deneysel yap\\u0131 ge\\u00e7erlili\\u011fi\\ny\\u00fcksek belirsizlik ko\\u015fullar\\u0131nda kapsaml\\u0131 bi\\u00e7imde s\\u0131nand\\u0131 ve operasyonel se\\u00e7enekler daralt\\u0131ld\\u0131.\\nBu ba\\u011flamda hipotez kapsam derinli\\u011fi ger\\u00e7ek\\u00e7i varsay\\u0131mlar e\\u015fli\\u011finde sistematik bi\\u00e7imde\\nincelendi ve karar s\\u0131n\\u0131rlar\\u0131 yeniden belirlendi.\\nPerformans s\\u00fcreklilik analiti\\u011fi kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar operasyonel ba\\u011flam alt\\u0131nda\\nfarkl\\u0131 perspektiflerden yorumland\\u0131. Bu \\u00e7er\\u00e7evede veri do\\u011frulama hiyerar\\u015fisi k\\u0131s\\u0131tl\\u0131 kaynak\\nko\\u015fullar\\u0131nda ba\\u011f\\u0131ms\\u0131z \\u00f6l\\u00e7\\u00fcmlerle do\\u011fruland\\u0131 ve performans farklar\\u0131 netle\\u015ftirildi. Bu \\u00e7er\\u00e7evede\\nolas\\u0131l\\u0131ksal kararl\\u0131l\\u0131k \\u00f6l\\u00e7\\u00fct\\u00fc k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda sistematik bi\\u00e7imde incelendi ve sapma\\nprofilleri s\\u0131n\\u0131fland\\u0131r\\u0131ld\\u0131.\\nKontrol mimarisi ba\\u011f\\u0131nt\\u0131s\\u0131 kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar kontroll\\u00fc de\\u011ferlendirme s\\u00fcrecinde\\nkar\\u015f\\u0131la\\u015ft\\u0131rmal\\u0131 olarak ele al\\u0131nd\\u0131. Bu \\u00e7er\\u00e7evede iteratif iyile\\u015ftirme h\\u0131z\\u0131 ard\\u0131\\u015f\\u0131k karar noktalar\\u0131nda\\nnicemsel g\\u00f6stergelerle de\\u011ferlendirildi ve uyum gereksinimleri yeniden yap\\u0131land\\u0131r\\u0131ld\\u0131. Buna\\nparalel olarak zaman \\u00e7\\u00f6z\\u00fcn\\u00fcrl\\u00fck penceresi k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda ard\\u0131\\u015f\\u0131k a\\u015famalarda\\ng\\u00f6zlemlendi ve uyum gereksinimleri yeniden yap\\u0131land\\u0131r\\u0131ld\\u0131.\\n\\u00d6ncelik \\u00e7at\\u0131\\u015fma \\u00e7\\u00f6z\\u00fcm\\u00fc kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda iteratif\\nolarak geli\\u015ftirildi. Ortaya \\u00e7\\u0131kan g\\u00f6zlemler \\u0131\\u015f\\u0131\\u011f\\u0131nda hesaplama y\\u00fck da\\u011f\\u0131l\\u0131m\\u0131 \\u00e7oklu senaryo\\nortam\\u0131nda nicemsel g\\u00f6stergelerle de\\u011ferlendirildi ve risk alanlar\\u0131 ayr\\u0131nt\\u0131land\\u0131r\\u0131ld\\u0131. Bu ba\\u011flamda\\ngeri besleme etki katsay\\u0131s\\u0131 uzun d\\u00f6nem izlemelerde iteratif olarak geli\\u015ftirildi ve operasyonel\\nse\\u00e7enekler daralt\\u0131ld\\u0131.\\nHesaplama y\\u00fck da\\u011f\\u0131l\\u0131m\\u0131 kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar kontroll\\u00fc de\\u011ferlendirme s\\u00fcrecinde\\niteratif olarak geli\\u015ftirildi. Elde edilen bulgular do\\u011frultusunda uyarlanabilir politika dengesi\\ny\\u00fcksek belirsizlik ko\\u015fullar\\u0131nda ba\\u011f\\u0131ms\\u0131z \\u00f6l\\u00e7\\u00fcmlerle do\\u011fruland\\u0131 ve alternatif yakla\\u015f\\u0131mlar\\nayr\\u0131\\u015ft\\u0131r\\u0131ld\\u0131. Bu de\\u011ferlendirme sonucunda deneysel yap\\u0131 ge\\u00e7erlili\\u011fi k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda\\n\\u00e7ok boyutlu bi\\u00e7imde analiz edildi ve karar s\\u0131n\\u0131rlar\\u0131 yeniden belirlendi. Elde edilen bulgular\\ndo\\u011frultusunda olas\\u0131l\\u0131ksal kararl\\u0131l\\u0131k \\u00f6l\\u00e7\\u00fct\\u00fc operasyonel ba\\u011flam alt\\u0131nda nicemsel g\\u00f6stergelerle\\nde\\u011ferlendirildi ve sapma profilleri s\\u0131n\\u0131fland\\u0131r\\u0131ld\\u0131.\\nAlternatif senaryo \\u00f6nceli\\u011fi kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar y\\u00fcksek belirsizlik ko\\u015fullar\\u0131nda \\u00e7ok\\nboyutlu bi\\u00e7imde analiz edildi. Elde edilen bulgular do\\u011frultusunda \\u00e7\\u0131kt\\u0131 g\\u00fcvenilirlik \\u00e7er\\u00e7evesi\\n\\u00e7oklu senaryo ortam\\u0131nda ard\\u0131\\u015f\\u0131k a\\u015famalarda g\\u00f6zlemlendi ve \\u00e7\\u0131kt\\u0131 g\\u00fcven aral\\u0131klar\\u0131 olu\\u015fturuldu.\\n\\nElde edilen bulgular do\\u011frultusunda \\u00f6l\\u00e7\\u00fcm do\\u011frulama band\\u0131 k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda yeniden\\nyap\\u0131land\\u0131r\\u0131ld\\u0131 ve \\u00f6ncelik dengeleri g\\u00fcncellendi. \\u0130lgili sonu\\u00e7lar dikkate al\\u0131nd\\u0131\\u011f\\u0131nda performans\\ns\\u00fcreklilik analiti\\u011fi operasyonel ba\\u011flam alt\\u0131nda sistematik bi\\u00e7imde incelendi ve izleme \\u00f6l\\u00e7\\u00fctleri\\nyeniden tan\\u0131mland\\u0131.\\nNedensel zincir tutarl\\u0131l\\u0131\\u011f\\u0131 kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar operasyonel ba\\u011flam alt\\u0131nda\\nba\\u011f\\u0131ms\\u0131z \\u00f6l\\u00e7\\u00fcmlerle do\\u011fruland\\u0131. Bu de\\u011ferlendirme sonucunda uygulama s\\u00fcreklilik seviyesi\\nkontroll\\u00fc de\\u011ferlendirme s\\u00fcrecinde nicemsel g\\u00f6stergelerle de\\u011ferlendirildi ve \\u00f6ncelik dengeleri\\ng\\u00fcncellendi. Buna paralel olarak \\u00e7\\u0131kt\\u0131 dengeleme mekanizmas\\u0131 y\\u00fcksek belirsizlik ko\\u015fullar\\u0131nda\\niteratif olarak geli\\u015ftirildi ve uyum gereksinimleri yeniden yap\\u0131land\\u0131r\\u0131ld\\u0131. Bu de\\u011ferlendirme\\nsonucunda kapsam uyum matrisi zaman ufku boyunca farkl\\u0131 perspektiflerden yorumland\\u0131 ve\\n\\u00f6ncelik dengeleri g\\u00fcncellendi.\\nOlas\\u0131l\\u0131ksal kararl\\u0131l\\u0131k \\u00f6l\\u00e7\\u00fct\\u00fc kapsam\\u0131nda y\\u00fcr\\u00fct\\u00fclen \\u00e7al\\u0131\\u015fmalar operasyonel ba\\u011flam alt\\u0131nda \\u00e7ok\\nboyutlu bi\\u00e7imde analiz edildi. Elde edilen bulgular do\\u011frultusunda kontrol mimarisi ba\\u011f\\u0131nt\\u0131s\\u0131\\noperasyonel ba\\u011flam alt\\u0131nda kapsaml\\u0131 bi\\u00e7imde s\\u0131nand\\u0131 ve karar s\\u0131n\\u0131rlar\\u0131 yeniden belirlendi. \\u0130lgili\\nsonu\\u00e7lar dikkate al\\u0131nd\\u0131\\u011f\\u0131nda performans s\\u00fcreklilik analiti\\u011fi ger\\u00e7ek\\u00e7i varsay\\u0131mlar e\\u015fli\\u011finde \\u00e7ok\\nboyutlu bi\\u00e7imde analiz edildi ve operasyonel se\\u00e7enekler daralt\\u0131ld\\u0131. Elde edilen bulgular\\ndo\\u011frultusunda \\u00f6ncelik \\u00e7at\\u0131\\u015fma \\u00e7\\u00f6z\\u00fcm\\u00fc k\\u0131s\\u0131tl\\u0131 kaynak ko\\u015fullar\\u0131nda yeniden yap\\u0131land\\u0131r\\u0131ld\\u0131 ve\\nsapma profilleri s\\u0131n\\u0131fland\\u0131r\\u0131ld\\u0131.\\nBoyut\\nDurum\\nDe\\u011ferlendirme\\nUyum\\nd\\u00fc\\u015f\\u00fck\\nkritik\\nKarar\\nk\\u0131sa\\nrevize ediliyor\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"label\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 5,\n        \"samples\": [\n          \"finans\",\n          \"musteri_hizmetleri\",\n          \"ar_ge\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"path\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3609,\n        \"samples\": [\n          \"/content/drive/MyDrive/Colab Notebooks/zor_veri_seti/musteri_hizmetleri/mh_karma_yeni3_15.pdf\",\n          \"/content/drive/MyDrive/Colab Notebooks/zor_veri_seti/ar_ge/arge_karisik_6.pdf\",\n          \"/content/drive/MyDrive/Colab Notebooks/zor_veri_seti/ar_ge/arge_doc_000704.pdf\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":6}]},{"cell_type":"code","source":["X = df[\"text\"]      # Belgelerin metinleri\n","y = df[\"label\"]     # Hangi departman (IK, Finans, Hukuk, MH, ArGe)\n","\n","# veriyi eğitim ve test olarak böleceğiz\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X, y,\n","    test_size=0.2,       # verinin %20'si test, %80'i eğitim\n","    random_state=42,     # sonuçları tekrar üretilebilir yapmak için\n","    stratify=y           # her departmandan orantılı örnek gelsin\n",")\n","\n","print(\"Toplam örnek sayısı:\", len(df))\n","print(\"Eğitim seti sayısı:\", len(X_train))\n","print(\"Test seti sayısı:\", len(X_test))\n","\n","print(\"\\nEğitim seti sınıf dağılımı:\")\n","print(y_train.value_counts())\n","\n","print(\"\\nTest seti sınıf dağılımı:\")\n","print(y_test.value_counts())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-iHWWzsyPGn1","executionInfo":{"status":"ok","timestamp":1766931773489,"user_tz":-180,"elapsed":10,"user":{"displayName":"Zeynepgül Sakaoğlu","userId":"18219194151370836346"}},"outputId":"87f3d433-f066-44a4-ac58-36d28a630bce","collapsed":true},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Toplam örnek sayısı: 3609\n","Eğitim seti sayısı: 2887\n","Test seti sayısı: 722\n","\n","Eğitim seti sınıf dağılımı:\n","label\n","ar_ge                 672\n","finans                560\n","musteri_hizmetleri    552\n","insan_kaynaklari      552\n","hukuk                 551\n","Name: count, dtype: int64\n","\n","Test seti sınıf dağılımı:\n","label\n","ar_ge                 168\n","finans                140\n","hukuk                 138\n","insan_kaynaklari      138\n","musteri_hizmetleri    138\n","Name: count, dtype: int64\n"]}]},{"cell_type":"code","source":["def clean_text(text):                                      #GURULTUSUZ VERI SETI\n","    text = text.lower()        #hepsini kucuk harf yapar\n","    text = text.replace(\"\\n\", \" \")    #satir sonuna bosluk yapiyor metin tek bir satir gibi okunuyor\n","    text = re.sub(r\"[^0-9a-zçğıöşüı\\s]\", \" \", text) #icindeki karakterler haricini temizliyor\n","    text = re.sub(r\"\\s+\", \" \", text).strip() #noktalama isaretlerini bosluk yapiyor ve bastaki ve sondaki bosluklari siliyor\n","    return text\n","\n","  #yani aslinda burda gereksiz isaretleri vb temizleyerek modelin asil bilgiye odaklanmasini sagladik\n","\n","# eğitim ve test verisine uygula\n","X_train_clean = X_train.apply(clean_text)\n","X_test_clean  = X_test.apply(clean_text)\n","\n","\n"],"metadata":{"id":"t9Yt2tJYPw-w"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["max_words = 20000\n","max_seq_len = 500\n","\n","tokenizer = Tokenizer(num_words=max_words, oov_token=\"<UNK>\")  #en cok kullanilan 20000 sozcugu sozluge al bir kelime sozlukte yoksa unk id si ver\n","tokenizer.fit_on_texts(X_train_clean)  #tum kelimelere bir id atiyor\n","\n","train_seq = tokenizer.texts_to_sequences(X_train_clean)   # id atamistik mesela zeynep sakaoglu = [28 , 931] olarak idlerini diziye atadi\n","test_seq  = tokenizer.texts_to_sequences(X_test_clean)\n","\n","X_train_pad = pad_sequences(train_seq, maxlen=max_seq_len, padding=\"post\")  #her belgenin uzunlugunu 500e sabitliyot fazlaysa 500de kesiyor azsa sonunu 0 ile dolduruyor\n","X_test_pad  = pad_sequences(test_seq,  maxlen=max_seq_len, padding=\"post\")\n","\n","\n","#bunun sebebi lstmin sabit uzunlukta input degeri beklemesi ve metni sayiya cevirmezsek lstm kullnamiyoruz"],"metadata":{"id":"XSoV5Q1aP4Si"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["le = LabelEncoder()   #departman isimlerini de integer degerlere ceviriyoruz yani dep isimlerine de id atiyoruz\n","le.fit(y_train)\n","\n","y_train_enc = to_categorical(le.transform(y_train))   #idleri vektor haline getiriyor\n","y_test_enc  = to_categorical(le.transform(y_test))\n","\n","\n","\n","#idleri vektor haline getirmesinin sebebi cikis katmaninda softmax kullaniyor olmak cunku bu vektor uretiyor"],"metadata":{"id":"LqsxtNHmP7NC"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["embedding_dim = 128\n","num_classes = len(le.classes_)\n","\n","model = Sequential([\n","    Embedding(input_dim=max_words, output_dim=embedding_dim, input_length=max_seq_len, input_shape=(max_seq_len,)\n","    #girdi=500, cikti her kelime 128 boyutlu vektor,\n","),\n","    Bidirectional(LSTM(64)), # 64 birimlik lstmi hem geri hem ileri yonde calistirir bizim cikti 128di 64 ileri 64 geri\n","    #belgenin basi ve sonu arasindaki iliskileri yakalar\n","    Dropout(0.3),\n","    Dense(64, activation=\"relu\"),  #lstmin 128 boyutlu ciktisini 64 boyutlu vektore sikistirir\n","    Dropout(0.3),\n","    Dense(num_classes, activation=\"softmax\")  # 5 sinif icin olasiliklari uretecek\n","])\n","\n","model.compile(\n","    optimizer=\"adam\",\n","    loss=\"categorical_crossentropy\",\n","    metrics=[\"accuracy\"]\n",")\n","\n","model.summary()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":410},"id":"nzY0KqYLP9ba","executionInfo":{"status":"ok","timestamp":1766931777554,"user_tz":-180,"elapsed":1179,"user":{"displayName":"Zeynepgül Sakaoğlu","userId":"18219194151370836346"}},"outputId":"0c88e9e6-b502-4d38-b405-37f44554a025","collapsed":true},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/embedding.py:97: UserWarning: Argument `input_length` is deprecated. Just remove it.\n","  warnings.warn(\n","/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/embedding.py:100: UserWarning: Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","  super().__init__(**kwargs)\n"]},{"output_type":"display_data","data":{"text/plain":["\u001b[1mModel: \"sequential\"\u001b[0m\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"sequential\"</span>\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃\u001b[1m \u001b[0m\u001b[1mLayer (type)                   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOutput Shape          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m      Param #\u001b[0m\u001b[1m \u001b[0m┃\n","┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\n","│ embedding (\u001b[38;5;33mEmbedding\u001b[0m)           │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m500\u001b[0m, \u001b[38;5;34m128\u001b[0m)       │     \u001b[38;5;34m2,560,000\u001b[0m │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ bidirectional (\u001b[38;5;33mBidirectional\u001b[0m)   │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m128\u001b[0m)            │        \u001b[38;5;34m98,816\u001b[0m │\n","├─────────────────────────────────┼────────