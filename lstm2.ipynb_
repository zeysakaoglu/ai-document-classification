{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1SOZonc4YMAob41Kf6GXu3nA_Sg1fRnVn","timestamp":1766925528132}],"gpuType":"A100","authorship_tag":"ABX9TyNPs5tRE6Sul+LmLkTbK/OV"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"iMeH8vkANKfS"},"outputs":[],"source":["import os\n","import re      # regex metin temizleme icin\n","\n","import numpy as np     #sayisal islemler\n","!pip install pymupdf -q\n","import fitz          # pdften metin cekmek icin\n","import pandas as pd    #veriyi tabloya cekebilmek icin kutuphane\n","from sklearn.preprocessing import LabelEncoder     #veri bolme islemleri vs\n","from sklearn.model_selection import train_test_split\n","\n","!pip install PyPDF2 -q\n","import PyPDF2\n","\n","import tensorflow as tf\n","from tensorflow.keras.preprocessing.text import Tokenizer\n","from tensorflow.keras.preprocessing.sequence import pad_sequences\n","from tensorflow.keras.utils import to_categorical\n","from tensorflow.keras.models import Sequential\n","from tensorflow.keras.layers import Embedding, LSTM, Bidirectional, Dense, Dropout"]},{"cell_type":"code","source":["from google.colab import drive                             # drivedan baglantisi kurarak veri setini yukledim\n","\n","drive.mount('/content/drive')\n","\n","DATASET_ROOT =  \"/content/drive/MyDrive/Colab Notebooks/zor_veri_seti\"\n","\n","\n","import os\n","\n","print(\"Veri setindeki departman klasörleri:\")\n","print(os.listdir(DATASET_ROOT))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yb2TJlz2NRgN","executionInfo":{"status":"ok","timestamp":1766931737834,"user_tz":-180,"elapsed":1295,"user":{"displayName":"Zeynepgül Sakaoğlu","userId":"18219194151370836346"}},"outputId":"7970834c-5df2-41a9-e002-8424f8a27136"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Veri setindeki departman klasörleri:\n","['hukuk', 'finans', 'ar_ge', 'insan_kaynaklari', 'musteri_hizmetleri']\n"]}]},{"cell_type":"code","source":["def extract_text_from_pdf(pdf_path):                       # bu fonksiyon ile pdf icindeki metni texte cevirir.\n","\n","    try:\n","        doc = fitz.open(pdf_path)                          # pdf dosyasini acip icindeki sayfalara erisebilmek icin\n","        full_text = []                                     # pdften okudugu metini bu listeye ekleyecek\n","\n","        for page in doc:                                   # pdfteki tum sayfalari okuyabilmesi icin dongu\n","            text = page.get_text()                         # Sayfadan metni cekiyor\n","            full_text.append(text)                         # metni olusturdugumuz listeye ekler\n","\n","        doc.close()                                        # pdf dosyasini kapatiyoruz\n","\n","        return \"\\n\".join(full_text).strip()                # okunan tum sayfalari birlestirir ve bastaki ve sondaki bosluklari siler.\n","\n","    except Exception as e:                                 # hata blogu. pdf okunamazsa program cokmesin diye,\n","        print(f\"PDF okunamadı: {pdf_path} → Hata: {e}\")\n","        return \"\""],"metadata":{"id":"UA116A6iOrEq"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["test_pdf = \"/content/drive/MyDrive/veri_seti/ar_ge/arge1 (1).pdf\"       # fonksiyonun dogru calisip calismadigini test ettim.\n","print(extract_text_from_pdf(test_pdf)[:500])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yAetgfZSOxzH","executionInfo":{"status":"ok","timestamp":1766931737853,"user_tz":-180,"elapsed":4,"user":{"displayName":"Zeynepgül Sakaoğlu","userId":"18219194151370836346"}},"outputId":"e46c8176-97af-477e-e140-2d63b2cbd844","collapsed":true},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["PDF okunamadı: /content/drive/MyDrive/veri_seti/ar_ge/arge1 (1).pdf → Hata: no such file: '/content/drive/MyDrive/veri_seti/ar_ge/arge1 (1).pdf'\n","\n"]}]},{"cell_type":"code","source":["def load_dataset_from_folders(root_dir):    # bu fonksiyon her klasoru bir departman etiketi olarak alir ve tum pdfleri text label ve path seklinde tabloya ekler\n","\n","    texts = []                              # burada text label ve path icin birer liste olusturduk\n","    labels = []\n","    paths = []\n","\n","\n","    for label_name in os.listdir(root_dir):                       # ana klasor altindaki departman klasorlerini tek tek dolas. yani bu 5 adet departman klasoru icin olusturdugum for dongusu.\n","        class_dir = os.path.join(root_dir, label_name)\n","\n","        if not os.path.isdir(class_dir):                          # dosya ise atliyor cunku etiketleri alabilmemiz icin sadece klasorlere bakmasi gerekiyor su an\n","            continue\n","\n","\n","        for pdf_file in os.listdir(class_dir):                    # burada 5 adet departman klasorunun her birinin icindeki pdfler icin olusturdugum for dongusu. yani klasorlerin icinde dolasacak\n","\n","            if not pdf_file.lower().endswith(\".pdf\"):             #pdf olmayan dosyalari atlar normalde hepsini pdfe cevirdim ama garanti olmasi icin\n","                continue\n","\n","            pdf_path = os.path.join(class_dir, pdf_file)          # o an for dongusunun ustunde oldugu dosya bilgilerini alir bu dosya ile islem yapacagiz\n","\n","\n","            text = extract_text_from_pdf(pdf_path)                # pdfi metne cevirebilmek icin yazdigimiz fonksiyonu kullandik\n","\n","            if len(text.strip()) == 0:                            # pdf bos ise atla\n","                continue\n","\n","            texts.append(text)                                    # burada okudugu pdfin test label ve path bilgilerini en basta olustuirdugumuz listeye ekliyor.\n","            labels.append(label_name)\n","            paths.append(pdf_path)\n","\n","\n","    df = pd.DataFrame({                                         # tabloyu olustur\n","        \"text\": texts,\n","        \"label\": labels,\n","        \"path\": paths\n","    })\n","\n","    return df                                                   # tabloyu dondur"],"metadata":{"id":"eKlMohdPO8gT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["df = load_dataset_from_folders(DATASET_ROOT)        # tabloyu olusturabiliyor mu diye test kodu\n","df.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":206},"id":"xXtQpPs4PCaJ","executionInfo":{"status":"ok","timestamp":1766931773480,"user_tz":-180,"elapsed":35611,"user":{"displayName":"Zeynepgül Sakaoğlu","userId":"18219194151370836346"}},"outputId":"bb16d79a-c260-487b-ce93-25d1bae25f7a","collapsed":true},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["                                                text  label  \\\n","0  KONU: Hukuk Birimi 1i Değerlendirme, Müşteri H...  hukuk   \n","1  KONU: Hukuk Birimi 5i Değerlendirme, Müşteri H...  hukuk   \n","2  KONU: Hukuk Birimi 3i Değerlendirme, Müşteri H...  hukuk   \n","3  KONU: Hukuk Birimi 3i Değerlendirme, Müşteri H...  hukuk   \n","4  KONU: Hukuk Birimi 5i Değerlendirme, Müşteri H...  hukuk   \n","\n","                                                path  \n","0  /content/drive/MyDrive/Colab Notebooks/zor_ver...  \n","1  /content/drive/MyDrive/Colab Notebooks/zor_ver...  \n","2  /content/drive/MyDrive/Colab Notebooks/zor_ver...  \n","3  /content/drive/MyDrive/Colab Notebooks/zor_ver...  \n","4  /content/drive/MyDrive/Colab Notebooks/zor_ver...  "],"text/html":["\n","  <div id=\"df-c9a8ba4b-f228-4c1e-8c7c-bbd68ce159b9\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","   